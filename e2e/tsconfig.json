{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
  "types": ["node"],
  "skipLibCheck": true,
  "allowJs": true,
  "checkJs": true
  },
  "include": [
  "playwright.config.ts",
  "playwright.config.js",
    "tests/**/*.ts"
  ]
}
