# Local development environment template for Restailor.
# Copy to .env at the repository root and fill in the values you need.

# Application mode
APP_ENV=development
STRICT_SECRETS=0

# Core auth and encryption
AUTH_SECRET_KEY=change-me-in-local-dev
VERIFY_SECRET_KEY=
RESET_SECRET_KEY=
PII_ENCRYPTION_KEY=change-me-encryption-key
TOTP_FERNET_KEY=
SECURITY_REMEMBER_SIGNER_SECRET=change-me-remember-signer
ADMIN_API_KEY=

# Database
DATABASE_URL=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=restailor
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=restailor

# Redis
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# LLM providers
OPENAI_API_KEY=
CLAUDE_API_KEY=
GEMINI_API_KEY=
GROK_API_KEY=

# Email / SMTP
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=Restailor
MAIL_STARTTLS=0
MAIL_SSL_TLS=0
MAIL_USE_CREDENTIALS=0
MAIL_USERNAME=
MAIL_PASSWORD=
EMAIL_DISABLE_OUTBOUND=1

# Captcha / abuse controls
LOGIN_CAPTCHA_REQUIRED=0
SIGNUP_CAPTCHA_REQUIRED=0
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# WebAuthn
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Restailor
WEBAUTHN_ORIGIN=http://localhost:3000

# Frontend and redirect URLs
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_GTAG_ID=
NEXT_PUBLIC_FEATURE_ANALYTICS=0
FRONTEND_URL=http://localhost:3000
FRONTEND_REDIRECT_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:8000
DEMO_USER_EMAIL=demo@example.com

# Cookies and HTTPS
COOKIE_SECURE=0
COOKIE_DOMAIN=
FORCE_HTTPS_HEADERS=0

# Optional billing and payments
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional feature flags
FEATURE_CANCEL_V2=1
REQUIRE_ADMIN_2FA=0